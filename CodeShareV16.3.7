--[[ 
    TTT HUB V16.3.7 - TRULY FIXED
    - IAM: Tắt là dừng hoàn toàn, không chạy ngầm.
    - Team Check: Xóa vĩnh viễn (Everyone is a target).
    - ESP: 16.1 Box chuẩn, không lệch, không lag.
    - Radius: Tăng/Giảm mượt, bóp là nhỏ, thả là to.
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local cam = workspace.CurrentCamera

--// 1. GUI SETUP
if player.PlayerGui:FindFirstChild("TTTHub_FinalFix") then player.PlayerGui.TTTHub_FinalFix:Destroy() end
local gui = Instance.new("ScreenGui", player.PlayerGui); gui.Name = "TTTHub_FinalFix"; gui.DisplayOrder = 999

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0, 320, 0, 500); main.Position = UDim2.new(0.5, -160, 0.5, -250)
main.BackgroundColor3 = Color3.fromRGB(30, 30, 30); main.Active = true; main.Draggable = true
Instance.new("UICorner", main)

--// 2. TAB SYSTEM
local tabBar = Instance.new("Frame", main); tabBar.Size = UDim2.new(1, 0, 0, 40); tabBar.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Instance.new("UICorner", tabBar)

local container = Instance.new("Frame", main); container.Size = UDim2.new(1, -20, 1, -60); container.Position = UDim2.new(0, 10, 0, 50); container.BackgroundTransparency = 1

local function createTab(name, pos)
    local b = Instance.new("TextButton", tabBar)
    b.Size = UDim2.new(0.25, 0, 1, 0); b.Position = UDim2.new(pos, 0, 0, 0); b.Text = name
    b.TextColor3 = Color3.new(1, 1, 1); b.BackgroundTransparency = 1; b.Font = "GothamBold"; b.TextSize = 10
    
    local c = Instance.new("ScrollingFrame", container)
    c.Size = UDim2.new(1, 0, 1, 0); c.Visible = false; c.BackgroundTransparency = 1; c.ScrollBarThickness = 2; c.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Instance.new("UIListLayout", c).Padding = UDim.new(0, 8)
    
    b.MouseButton1Click:Connect(function()
        for _, v in pairs(container:GetChildren()) do if v:IsA("ScrollingFrame") then v.Visible = false end end
        c.Visible = true
    end)
    return c
end

local cMove, cPvP, cTP, cIAM = createTab("MOVE", 0), createTab("PvP", 0.25), createTab("TP", 0.5), createTab("IAM", 0.75)
cPvP.Visible = true

--// 3. UI HELPERS
local function createToggle(parent, text, callback)
    local btn = Instance.new("TextButton", parent); btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45); btn.Text = text .. ": OFF"; btn.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", btn)
    local on = false
    btn.MouseButton1Click:Connect(function()
        on = not on; btn.Text = text .. (on and ": ON" or ": OFF")
        btn.BackgroundColor3 = on and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(45, 45, 45); callback(on)
    end)
end

local function createBtn(parent, text, callback)
    local btn = Instance.new("TextButton", parent); btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60); btn.Text = text; btn.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", btn); btn.MouseButton1Click:Connect(callback)
end

--// 4. CONTROL VARIABLES
local silentOn, iamBotOn, espOn, flyOn = false, false, false, false
local flySpeed, fovRadius = 50, 100
local selectedPlayer, loopTp, iamLock = nil, false, false

local fovCircle = Instance.new("Frame", gui)
fovCircle.BackgroundTransparency = 1; fovCircle.AnchorPoint = Vector2.new(0.5, 0.5); fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
fovCircle.Size = UDim2.new(0, fovRadius*2, 0, fovRadius*2); fovCircle.Visible = false
local fovStroke = Instance.new("UIStroke", fovCircle); fovStroke.Thickness = 1.5; fovStroke.Color = Color3.new(1, 1, 1)
Instance.new("UICorner", fovCircle).CornerRadius = UDim.new(1, 0)

--// 5. TABS CONTENT
createToggle(cMove, "Super Fly", function(v) flyOn = v end)
createBtn(cMove, "Fly Speed +10", function() flySpeed = flySpeed + 10 end)
createBtn(cMove, "Fly Speed -10", function() flySpeed = math.max(10, flySpeed - 10) end)

createToggle(cPvP, "Silent Aim", function(v) silentOn = v end)
createToggle(cPvP, "IAM Bot (Auto Lock)", function(v) iamBotOn = v end)
createToggle(cPvP, "ESP (No Team Check)", function(v) 
    espOn = v 
    if not v then for _, p in pairs(Players:GetPlayers()) do if p.Character and p.Character:FindFirstChild("TTT_ESP") then p.Character.TTT_ESP:Destroy() end end end
end)
createToggle(cPvP, "Show Radius", function(v) fovCircle.Visible = v end)
createBtn(cPvP, "Radius +20", function() fovRadius = fovRadius + 20; fovCircle.Size = UDim2.new(0, fovRadius*2, 0, fovRadius*2) end)
createBtn(cPvP, "Radius -20", function() fovRadius = math.max(10, fovRadius - 20); fovCircle.Size = UDim2.new(0, fovRadius*2, 0, fovRadius*2) end)

createToggle(cTP, "Loop TP Target", function(v) loopTp = v end)
createToggle(cTP, "Stick To Target", function(v) iamLock = v end)

-- IAM List
local tLabel = Instance.new("TextLabel", cIAM); tLabel.Size = UDim2.new(1,0,0,25); tLabel.Text = "Target: None"; tLabel.TextColor3 = Color3.new(1,1,0); tLabel.BackgroundTransparency = 1
local pList = Instance.new("Frame", cIAM); pList.Size = UDim2.new(1,0,0,200); pList.BackgroundTransparency = 1
Instance.new("UIListLayout", pList).Padding = UDim.new(0, 5)

local function refresh()
    for _, v in pairs(pList:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local b = Instance.new("TextButton", pList); b.Size = UDim2.new(1,0,0,25); b.Text = p.Name; b.BackgroundColor3 = Color3.fromRGB(50,50,50); b.TextColor3 = Color3.new(1,1,1)
            b.MouseButton1Click:Connect(function() 
                if selectedPlayer == p then selectedPlayer = nil; tLabel.Text = "Target: None"
                else selectedPlayer = p; tLabel.Text = "Target: "..p.Name end
            end)
        end
    end
end
createBtn(cIAM, "Refresh & Clear Target", function() selectedPlayer = nil; tLabel.Text = "Target: None"; refresh() end)
refresh()

--// 6. LOGIC EXECUTION
local function getTarget()
    -- Nếu tắt IAM Bot và Silent Aim thì trả về nil luôn, không quét gì cả
    if not iamBotOn and not silentOn then return nil end
    
    if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("Head") then return selectedPlayer.Character.Head end
    
    local target, min_dist = nil, fovRadius
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
            local pos, os = cam:WorldToViewportPoint(p.Character.Head.Position)
            if os then
                local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if d < min_dist then min_dist = d; target = p.Character.Head end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    local target = getTarget()
    if flyOn and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        player.Character.HumanoidRootPart.Velocity = cam.CFrame.LookVector * flySpeed
    end
    if iamBotOn and target then cam.CFrame = CFrame.new(cam.CFrame.Position, target.Position) end
    if (loopTp or iamLock) and selectedPlayer and selectedPlayer.Character then
        player.Character.HumanoidRootPart.CFrame = selectedPlayer.Character.HumanoidRootPart.CFrame
    end
    if espOn then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local folder = p.Character:FindFirstChild("TTT_ESP") or Instance.new("Folder", p.Character); folder.Name = "TTT_ESP"
                local box = folder:FindFirstChild("Box") or Instance.new("BoxHandleAdornment", folder)
                box.Adornee = p.Character; box.AlwaysOnTop = true; box.Size = Vector3.new(4, 5.5, 0); box.Color3 = Color3.new(1,0,0); box.Transparency = 0.6
                local tag = folder:FindFirstChild("Tag") or Instance.new("BillboardGui", folder)
                tag.Adornee = p.Character.Head; tag.Size = UDim2.new(0,100,0,40); tag.AlwaysOnTop = true; tag.ExtentsOffset = Vector3.new(0,3,0)
                local txt = tag:FindFirstChild("Txt") or Instance.new("TextLabel", tag)
                txt.Size = UDim2.new(1,0,1,0); txt.BackgroundTransparency = 1; txt.TextColor3 = Color3.new(1,1,1); txt.Text = p.Name; txt.TextSize = 10
            end
        end
    end
end)

local old; old = hookmetamethod(game, "__index", function(s, i)
    if silentOn and i == "Hit" and s:IsA("Mouse") then
        local t = getTarget()
        if t then return t.CFrame end
    end
    return old(s, i)
end)

local mBtn = Instance.new("TextButton", gui)
mBtn.Size = UDim2.new(0, 45, 0, 45); mBtn.Position = UDim2.new(0, 10, 0.4, 0); mBtn.Text = "T"
mBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255); Instance.new("UICorner", mBtn).CornerRadius = UDim.new(1, 0)
mBtn.MouseButton1Click:Connect(function() main.Visible = not main.Visible end)
