flyBtn.Position = UDim2.new(0,20,0,270)

local function updateFlyUI()
	flyBtn.Text = "Fly: "..(flying and "ON" or "OFF")
	flyBtn.BackgroundColor3 = flying and Color3.fromRGB(0,170,0) or Color3.fromRGB(170,0,0)
end

updateFlyUI()

flyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	updateFlyUI()

	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if flying then
		bv = Instance.new("BodyVelocity",hrp)
		bv.MaxForce = Vector3.new(1e5,1e5,1e5)

		bg = Instance.new("BodyGyro",hrp)
		bg.MaxTorque = Vector3.new(1e5,1e5,1e5)

		RunService.RenderStepped:Connect(function()
			if flying and hrp then
				bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * settings.speedValue
				bg.CFrame = workspace.CurrentCamera.CFrame
			end
		end)
	else
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
	end
end)

