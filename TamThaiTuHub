-- SLIDER FUNCTION
local function createSlider(parent, name, yPos, min, max, key)
	local frame = Instance.new("Frame", parent)
	frame.Size = UDim2.new(0,240,0,50)
	frame.Position = UDim2.new(0,20,0,yPos)

	local bar = Instance.new("Frame", frame)
	bar.Size = UDim2.new(1,-20,0,6)
	bar.Position = UDim2.new(0,10,0.5,-3)

	local fill = Instance.new("Frame", bar)
	fill.BackgroundColor3 = Color3.new(1,1,1)

	local knob = Instance.new("Frame", bar)
	knob.Size = UDim2.new(0,12,0,12)

	local label = Instance.new("TextLabel", frame)
	label.Size = UDim2.new(1,0,0,20)
	label.Position = UDim2.new(0,0,0,-20)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1,1,1)

	local dragging = false

	local function update(x)
		local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,0,1)
		fill.Size = UDim2.new(rel,0,1,0)
		knob.Position = UDim2.new(rel,-6,0.5,-6)
		
		settings[key] = math.floor(min + (max-min)*rel)
		label.Text = name..": "..settings[key]
		
		save()
		apply()
	end

	knob.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=true end
	end)

	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end
	end)

	UIS.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			update(i.Position.X)
		end
	end)

	label.Text = name..": "..settings[key]
end

createSlider(tab2,"Speed Value",120,8,150,"speedValue")
